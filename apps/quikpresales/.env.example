# Copy to .env.local and fill in your local-dev values. Never commit .env.local.

# ── Database ────────────────────────────────────────────────────────────────
# Shared multi-schema Postgres. QuikPreSales owns the `app_quikpresales` schema.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quikit_dev"
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# ── NextAuth ────────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET must be IDENTICAL across every app in the cluster.
# Generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3015"

# ── QuikIT SSO (OIDC IdP) ───────────────────────────────────────────────────
# QUIKIT_CLIENT_ID must equal the app slug. Register the App + OAuthClient via
# the super-admin App Registry UI, then paste the generated secret here.
QUIKIT_URL="http://localhost:3000"
NEXT_PUBLIC_QUIKIT_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3001"
QUIKIT_CLIENT_ID="quikpresales"
QUIKIT_CLIENT_SECRET="dev-client-secret-placeholder"

# ── Service-to-service ──────────────────────────────────────────────────────
INTERNAL_SECRET=""

# ── Redis (feature flags + dashboard aggregate cache; fails open if unset) ──
REDIS_URL=""

# ── AI (Anthropic Claude) ───────────────────────────────────────────────────
# When unset, lib/ai/claude.ts runs in stub mode and every AI surface renders
# a deterministic placeholder marked `isStub`.
ANTHROPIC_API_KEY=""

# ── File storage (Vercel Blob) ──────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Optional ────────────────────────────────────────────────────────────────
CRON_SECRET=""
RESEND_API_KEY=""
RESEND_FROM=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
